# ── VCS / build artefacts ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.DS_Store
*.patch
*.pytest_cache
 
# ── Local diagnostics — never ship ───────────────────────────────────
# One-off probes (octopus_*_probe.py, probe_*.py, *_probe.py, etc.), ANCHORED to the
# repo root by the leading slash — the root is where probes are written, and all 17 of
# them live there. Unanchored, this also swallowed tests/test_*_probe.py: four real
# suite files carrying 67 tests, which a fresh clone never saw and which could not
# travel in a patch, so they silently drifted from the code they cover.
/*probe*.py
# EXCEPT the two modules that are SHIPPED CODE despite the name. Both are imported by
# engine.py, so an unexcepted one is absent from a fresh clone and the import raises
# ModuleNotFoundError at runtime — invisible locally, because a working tree has the
# file whether or not git tracks it.
#   statistics_probe  — core attribution path (_stitch_hourly_energy → _to_utc)
#   consumption_probe — backs /api/historical/probe and /api/historical/probe-devices
#                       (the Historical Probe panel); untracked until 4.5.13
!statistics_probe.py
!consumption_probe.py
# Shape tracker + its no-cron runner and CSV history
emt_shape_tracker.py
emt_tracker_loop.py
emt_shape_history*.csv
# Any CSV export / dump, and scratch dumps
*.csv
dir.txt
*.patch
# Test run outputs
*.log
test_results.json
 
# NOTE: requirements.txt, screenshots/ and .build/ CI scripts are
# intentionally tracked — do not ignore them.

# ── Test scaffolding — created by run_tests.sh, removed again on exit ────────
# Symlinks into the source tree so tests can load sibling modules by path. They
# are build artefacts; a stale copy committed here shows up in every later diff.
tests/block_store.py
tests/energy_charts.py
tests/energy_engine_io.py
tests/engine.py
tests/ha_client.py
tests/instance.py
tests/kraken_api_client.py
tests/kraken_ingester.py
tests/kraken_mini.py
tests/kraken_rates.py
tests/main.py
tests/server.py
tests/web
tests/templates
# Scratch config a test used to write here (it now uses a temp dir) — ignored so
# an old working copy can't reintroduce it.
tests/_test_meters_config.json
